# Copiez ce fichier en .env puis remplissez les valeurs.

# Clé créée sur https://console.anthropic.com (ne la partagez jamais)
ANTHROPIC_API_KEY=sk-ant-...

# Code d'accès demandé dans l'app (fortement conseillé, obligatoire en ligne)
APP_CODE=

# Modèles utilisés (facultatif)
MODEL_LESSON=claude-sonnet-5-5
MODEL_CHAT=claude-haiku-5-5

# Port du serveur (facultatif)
PORT=3000
