# Copiez ce fichier en .env puis remplissez les valeurs.
# L'app utilise des modèles d'IA open source GRATUITS. Voir le README.

# Fournisseur : groq (conseillé), openrouter ou ollama (sur ton ordinateur)
AI_PROVIDER=groq

# Clé gratuite du fournisseur (inutile avec ollama)
#   groq       → https://console.groq.com/keys
#   openrouter → https://openrouter.ai/keys
AI_API_KEY=

# Code d'accès demandé dans l'app (fortement conseillé, obligatoire en ligne)
APP_CODE=

# Facultatif : changer de modèle (sinon, valeurs par défaut du fournisseur)
#   groq       : llama-3.3-70b-versatile
#   openrouter : meta-llama/llama-3.3-70b-instruct:free
#   ollama     : qwen2.5:7b
MODEL_LESSON=
MODEL_CHAT=

# Facultatif : adresse de l'API si tu utilises un autre service compatible OpenAI
# (LM Studio, Together, Mistral, etc.)
AI_BASE_URL=

# Port du serveur (facultatif)
PORT=3000
