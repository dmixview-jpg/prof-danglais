// Règles de sécurité Firestore pour Prof d'anglais.
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function connecte(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Administrateur : marque admin=true donnée par outils/admin/nommer_admin.mjs
    // Le courriel doit être confirmé : sinon, quelqu'un pourrait créer un compte avec ton adresse
    // avant toi et recevoir le rôle d'administrateur.
    function admin() {
      return request.auth != null && request.auth.token.admin == true
        && request.auth.token.email_verified == true;
    }

    // Type et taille de chaque champ de progression : empêche d'écrire des documents énormes
    // (quotas, coûts) ou des valeurs absurdes qui fausseraient le tableau de bord.
    // Plafonds larges : 184 leçons et environ 1 300 mots dans tout le parcours, 400 jours gardés.
    // null est accepté : l'app envoie null pour ce qui n'existe pas encore sur l'appareil.
    function progressionValide(d) {
      return (!('progress' in d) || d.progress == null || (d.progress is map && d.progress.size() <= 1000))
        && (!('lessons' in d) || d.lessons == null || (d.lessons is int && d.lessons >= 0 && d.lessons <= 100000))
        && (!('days' in d) || d.days == null || (d.days is list && d.days.size() <= 400))
        && (!('dialogues' in d) || d.dialogues == null || (d.dialogues is map && d.dialogues.size() <= 200))
        && (!('vocab' in d) || d.vocab == null || (d.vocab is list && d.vocab.size() <= 3000))
        && (!('level' in d) || d.level == null || (d.level is string && d.level.size() <= 10))
        && (!('pathLevel' in d) || d.pathLevel == null || (d.pathLevel is string && d.pathLevel.size() <= 10));
    }

    // Progression de chaque personne : elle seule peut la lire et la modifier.
    match /users/{uid} {
      allow read, delete: if connecte(uid);
      allow create, update: if connecte(uid)
        && request.resource.data.keys().hasOnly(['name', 'data', 'updatedAt', 'consent'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!('data' in request.resource.data) || (request.resource.data.data is map
          && request.resource.data.data.keys().hasOnly(['progress', 'lessons', 'days', 'dialogues', 'vocab', 'level', 'pathLevel'])
          && progressionValide(request.resource.data.data)))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time)
        && (!('consent' in request.resource.data) || (request.resource.data.consent is map
          && request.resource.data.consent.keys().hasOnly(['version', 'at'])));
    }

    // Abonné Premium : achats App Store et Google Play, attribut revenueCatEntitlements donné par
    // la fonction revenuecatWebhook (functions/). Le site Web ne vend rien.
    function abonne() {
      return request.auth != null
        && ('revenueCatEntitlements' in request.auth.token && 'premium' in request.auth.token.revenueCatEntitlements);
    }

    // Contenu payant (A1 à C2) : lisible seulement par les abonnés et l'administrateur.
    // Écrit uniquement par outils/programme/publier_premium.mjs (compte de service).
    match /contenu/{niveau} {
      allow read: if abonne() || admin();
      allow write: if false;
    }

    // Abonnements App Store et Google Play : un document par compte.
    // Écrit par la fonction revenuecatWebhook seulement (functions/) ; lu par la personne et par le tableau de bord.
    match /revenuecat/{uid} {
      allow read: if connecte(uid) || admin();
    }
    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
