"scenarios": [
{
"id": "intro",
"emoji": "👋",
"title": "Se présenter",
"level": "A1",
"intro": "Tu rencontres quelqu’un à une fête.",
"turns": [
{
"coach": "Hi! I’m Kevin. What’s your name?",
"fr": "Salut! Je suis Kevin. Comment t’appelles-tu?"
},
{
"options": [
"My name is Julie.",
"I call me Julie.",
"My name Julie."
],
"answer": 0,
"explain": "« Je m’appelle » = My name is… ou I’m… « I call me » est un calque du français."
},
{
"coach": "Nice to meet you, Julie! Where are you from?",
"fr": "Enchanté, Julie! D’où viens-tu?"
},
{
"options": [
"I’m come from Paris.",
"I’m from Paris.",
"I from Paris."
],
"answer": 1,
"explain": "I’m from + lieu. Pas de « come » après « I’m »."
},
{
"coach": "Cool! How old are you, if I may ask?",
"fr": "Cool! Quel âge as-tu, si je peux me permettre?"
},
{
"options": [
"I have thirty years.",
"I’m thirty.",
"I’m thirty years."
],
"answer": 1,
"explain": "L’âge se dit avec be : I’m thirty (ou thirty years old)."
},
{
"coach": "And what do you do?",
"fr": "Et que fais-tu dans la vie?"
},
{
"options": [
"I’m nurse.",
"I’m a nurse.",
"I work nurse."
],
"answer": 1,
"explain": "Le métier prend a ou an : I’m a nurse."
},
{
"coach": "That’s great! Do you speak other languages?",
"fr": "Super! Parles-tu d’autres langues?"
},
{
"options": [
"Yes, I speak french and a little english.",
"Yes, I speak French and a little English.",
"Yes, I speak French and little English."
],
